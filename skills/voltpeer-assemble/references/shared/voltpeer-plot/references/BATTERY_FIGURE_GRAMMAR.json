{
  "version": "0.1-evidence-seed",
  "scope": "Figure selection and data-contract guide. A listed type is not a promise that an automated renderer exists.",
  "common_required": ["source_data", "evidence_state", "cell_or_sample_identity", "axis_units", "processing_log"],
  "evidence_states": ["measured", "calculated", "modelled", "schematic", "synthetic_demo"],
  "processing_rule": "Preserve the raw data. Record every transformation, exclusion, smoothing, normalization and fit with parameters; never fabricate missing measurements.",
  "style_rule": "Project-generated per-cycle capacity, CE, retention and rate/recovery capacity use unconnected points. Continuous signals use solid marker-free traces. Full-cell cycling requires same-cycle CE and explicitly referenced retention. Assembly inherits these rules; supplied original figures retain their encoding. These are project preferences, not universal journal requirements. Apply journal physical-size specifications separately.",
  "pairing_promotion_rule": "A default pairing needs at least three independently authored primary papers with figure/panel references checked. Other pairings are optional examples, never auto-created filler panels.",
  "types": [
    {"id":"li_cu_cycle_ce","family":"electrochemistry","x":"cycle number","y":"Coulombic efficiency (%)","required":["Li||Cu protocol","current density","plated areal capacity","stripping cutoff","electrolyte","temperature","CE numerator and denominator if recalculated"],"never_infer":["Aurbach protocol","average CE interval","failure removal"],"render":"original cycle observations as markers without connecting lines; no smoothing","status":"evidence_backed"},
    {"id":"aurbach_ce","family":"electrochemistry","x":"protocol time or capacity","y":"cell voltage; calculated CE stated separately","required":["exact Aurbach or modified protocol","reservoir/plating capacities","number of cycles","current density","cutoff","CE equation"],"never_infer":["long-cycle CE trace from one mean CE"],"render":"protocol curve; calculated value annotated or in caption","status":"evidence_backed"},
    {"id":"li_cu_voltage_profile","family":"electrochemistry","x":"areal capacity (mAh cm^-2) or time","y":"voltage (V)","required":["cycle","current density","capacity basis","cutoff","reference"],"never_infer":["nucleation overpotential without definition"],"render":"selected cycles or currents only","status":"evidence_backed"},
    {"id":"li_li_symmetric","family":"electrochemistry","x":"elapsed time (h)","y":"signed cell voltage (mV or V)","required":["electrodes","current density","capacity per half-cycle","temperature","failure rule"],"never_infer":["full-cell lifetime from symmetric hours"],"render":"continuous signed trace; optional linked zoom","status":"evidence_backed"},
    {"id":"critical_current_density","family":"electrochemistry","x":"stage or time","y":"current density and polarization","required":["step sequence","capacity or time per step","failure criterion","temperature"],"never_infer":["critical threshold without stated criterion"],"render":"step schedule with voltage response","status":"candidate"},
    {"id":"li_nucleation_overpotential","family":"electrochemistry","x":"time or capacity","y":"potential (V)","required":["substrate","current density","capacity","reference","definition of overpotential"],"never_infer":["nucleation peak from a smoothed trace"],"render":"raw early plating segment with readable inset if needed","status":"candidate"},
    {"id":"anode_free_cycling","family":"cell_performance","x":"cycle number","y":"discharge capacity with stated basis","required":["zero-excess-Li cell definition","cathode loading","E/C","voltage window","rate","formation","same-cycle CE or charge capacity","CE definition","reference_cycle","reference_capacity","retention_basis"],"never_infer":["excess lithium inventory"],"render":"same-cycle capacity and CE as unconnected points; reference-defined retention; retain failure","status":"candidate"},
    {"id":"full_cell_long_cycle","family":"cell_performance","x":"cycle number","y":"discharge capacity (explicit basis)","required":["cathode/anode","loading or areal capacity","rate or current","voltage window","temperature","formation","same-cycle CE or charge capacity","CE definition","reference_cycle","reference_capacity","retention_basis"],"never_infer":["N/P","E/C","retention denominator"],"render":"same-cycle capacity and CE as unconnected points; reference-defined retention; request missing data","status":"evidence_backed"},
    {"id":"full_cell_ce","family":"cell_performance","x":"cycle number","y":"Coulombic efficiency (%)","required":["cell configuration","charge/discharge capacity basis","protocol","temperature"],"never_infer":["Li||Cu CE equivalence"],"render":"unconnected cycle observations; share cycle axis with corresponding capacity","status":"evidence_backed"},
    {"id":"capacity_retention","family":"cell_performance","x":"cycle number","y":"retention (%)","required":["explicit reference cycle","capacity basis","formation policy","formula","reference capacity"],"never_infer":["first cycle as denominator","missing cycles"],"render":"unconnected observed series; state reference cycle, reference capacity and matching conditions","status":"evidence_backed"},
    {"id":"rate_capability","family":"cell_performance","x":"actual cycle or ordered rate stage","y":"capacity (explicit basis)","required":["charge and discharge rates","cycles per stage","recovery stage if run","temperature"],"never_infer":["unreported recovery stage"],"render":"unconnected capacity observations in original cycle/stage order; mark rates and recovery","status":"evidence_backed"},
    {"id":"voltage_capacity_profile","family":"cell_performance","x":"capacity (mAh g^-1, mAh cm^-2 or mAh)","y":"voltage (V)","required":["cell","cycle","rate","charge/discharge direction","capacity basis"],"never_infer":["cycles absent from file"],"render":"continuous solid marker-free traces; preserve supplied cycles and direction","status":"evidence_backed"},
    {"id":"nyquist","family":"impedance","x":"Z' (ohm or normalized)","y":"-Z'' (same unit)","required":["cell","state of charge","temperature","frequency range","perturbation"],"never_infer":["Rct/RSEI from semicircle appearance","fitted line without circuit"],"render":"measured symbols; fit line only with circuit/parameters; check geometric aspect","status":"candidate"},
    {"id":"bode","family":"impedance","x":"frequency (Hz, log scale)","y":"|Z| and/or phase with units","required":["cell","state","frequency range","perturbation","temperature"],"never_infer":["equivalent circuit"],"render":"frequency-resolved amplitude/phase","status":"candidate"},
    {"id":"cv","family":"voltammetry","x":"potential (V vs stated reference)","y":"current (A) or current density","required":["working/counter/reference","scan rate","potential window","cycle","temperature"],"never_infer":["reaction assignment from peak alone"],"render":"selected scan directions/cycles","status":"candidate"},
    {"id":"lsv","family":"voltammetry","x":"potential (V vs stated reference)","y":"current or current density","required":["electrodes","scan rate","window","onset criterion"],"never_infer":["electrochemical window from visual onset"],"render":"full measured sweep","status":"candidate"},
    {"id":"gitt_raw","family":"transport","x":"time","y":"potential (V)","required":["pulse current","pulse duration","relaxation duration","cell","temperature"],"never_infer":["diffusion coefficient without calculation"],"render":"show pulses and relaxation","status":"candidate"},
    {"id":"gitt_diffusion","family":"transport","x":"potential or state of charge","y":"derived diffusion coefficient (cm^2 s^-1)","required":["raw GITT","equation","fit interval","geometry","assumptions"],"never_infer":["measured status for model output"],"render":"log y where appropriate; mark derived status","status":"candidate"},
    {"id":"dq_dv","family":"transport","x":"voltage (V)","y":"dQ/dV (stated unit)","required":["source voltage-capacity curve","cycle","direction","derivative method","smoothing parameters"],"never_infer":["peak assignment"],"render":"selected cycles, preserved raw source","status":"candidate"},
    {"id":"ionic_conductivity","family":"electrolyte_property","x":"temperature (K or deg C) or concentration","y":"conductivity (mS cm^-1)","required":["measurement method","cell constant/geometry","temperature","composition"],"never_infer":["Arrhenius law"],"render":"observations and uncertainty where available","status":"candidate"},
    {"id":"arrhenius_conductivity","family":"electrolyte_property","x":"1000/T (K^-1)","y":"log conductivity with stated base","required":["temperature in kelvin","conductivity data","model choice","fit interval"],"never_infer":["linear Arrhenius fit to VTF-shaped data"],"render":"points and documented fit","status":"candidate"},
    {"id":"viscosity","family":"electrolyte_property","x":"temperature or composition","y":"viscosity (mPa s)","required":["measurement method","temperature","composition"],"never_infer":["transport mechanism"],"render":"points with uncertainty where available","status":"candidate"},
    {"id":"li_transference_dc","family":"electrolyte_property","x":"polarization time","y":"current (A)","required":["cell","delta V","I0","Iss","R0","Rss","method/assumptions"],"never_infer":["absolute transport fraction from one number"],"render":"DC transient; pair before/after EIS when supplied","status":"candidate"},
    {"id":"raman","family":"spectroscopy","x":"Raman shift (cm^-1)","y":"intensity (a.u. or defined normalization)","required":["sample","raw/normalized status","baseline method","peak assignment source"],"never_infer":["real peaks from schematic functions"],"render":"measured spectra; state vertical offsets","status":"candidate"},
    {"id":"ftir","family":"spectroscopy","x":"wavenumber (cm^-1)","y":"absorbance or transmittance","required":["sample","measurement mode","baseline/normalization","band source"],"never_infer":["peak identity from color"],"render":"measured spectra with correct axis direction","status":"candidate"},
    {"id":"nmr","family":"spectroscopy","x":"chemical shift (ppm)","y":"intensity","required":["nucleus","solvent","reference","concentration","temperature"],"never_infer":["coordination mechanism from shift alone"],"render":"follow nucleus-specific direction convention","status":"candidate"},
    {"id":"rdf","family":"simulation","x":"pair distance r (angstrom)","y":"g(r)","required":["atom pair","simulation system","trajectory/window","force field"],"never_infer":["coordination number from peak height"],"render":"pair identities in legend; no generic peak","status":"candidate"},
    {"id":"coordination_number","family":"simulation","x":"pair distance r (angstrom)","y":"integrated coordination number","required":["atom pair","RDF source","integration cutoff","density/normalization"],"never_infer":["cutoff from aesthetic peak location"],"render":"curve or explicit first-shell value","status":"candidate"},
    {"id":"solvation_population","family":"simulation","x":"species or electrolyte","y":"fraction (%)","required":["SSIP/CIP/AGG definition","sampling method","denominator","uncertainty"],"never_infer":["100% composition from incomplete classes"],"render":"stacked bar only if classes are exhaustive","status":"candidate"},
    {"id":"xps_core_level","family":"surface","x":"binding energy (eV)","y":"intensity","required":["core level","calibration","background","fit model","component constraints"],"never_infer":["chemical identity from a color band"],"render":"raw, envelope, components distinguishable","status":"candidate"},
    {"id":"xps_depth_profile","family":"surface","x":"sputter time or calibrated depth","y":"atomic fraction or intensity","required":["sputter method","depth calibration if nm","sample state","normalization"],"never_infer":["time equals depth"],"render":"state depth uncertainty and sputter effects","status":"candidate"},
    {"id":"tof_sims_depth","family":"surface","x":"sputter time or calibrated depth","y":"ion signal with stated normalization","required":["ion fragments","polarity","sputter settings","normalization","depth calibration if nm"],"never_infer":["absolute composition from raw ion counts"],"render":"separate species traces with identity","status":"candidate"},
    {"id":"tof_sims_map","family":"surface","x":"calibrated image position","y":"calibrated image position","required":["ion fragments","field of view","pixel scale","color scale","normalization"],"never_infer":["same abundance from independent normalized maps"],"render":"same FoV and comparable scale for like channels","status":"candidate"},
    {"id":"tof_sims_3d","family":"surface","x":"calibrated spatial axes","y":"ion intensity or occupancy","required":["species","reconstruction parameters","sputter/depth calibration","normalization"],"never_infer":["physical geometry from uncalibrated stack"],"render":"3D reconstruction with traceable scale","status":"candidate"},
    {"id":"sem","family":"microscopy","x":"calibrated position","y":"calibrated position","required":["original image","scale calibration","sample/cycle state","processing log"],"never_infer":["particle size from uncalibrated screenshot"],"render":"preserve field; editable scale bar","status":"candidate"},
    {"id":"tem","family":"microscopy","x":"calibrated position","y":"calibrated position","required":["original image","scale calibration","sample state","imaging mode"],"never_infer":["lattice assignment without diffraction/calibration"],"render":"preserve pixels; editable annotations","status":"candidate"},
    {"id":"cryo_tem","family":"microscopy","x":"calibrated position","y":"calibrated position","required":["original image","cryo protocol","scale calibration","sample state"],"never_infer":["phase identity from texture alone"],"render":"preserve pixels; mark ROIs","status":"candidate"},
    {"id":"afm","family":"microscopy","x":"lateral position","y":"lateral position / height color","required":["scan size","z scale","mode","processing"],"never_infer":["height without calibrated colorbar"],"render":"height map and colorbar","status":"candidate"},
    {"id":"eds_mapping","family":"microscopy","x":"calibrated position","y":"calibrated position","required":["base image","element channels","same FoV","scale","mapping settings"],"never_infer":["quantitative fraction from pseudocolor alone"],"render":"base + individual maps + optional overlay","status":"candidate"},
    {"id":"xrd","family":"diffraction","x":"2theta (deg)","y":"intensity","required":["radiation","sample state","background handling","phase reference"],"never_infer":["phase assignment from an unlabeled peak"],"render":"measured patterns; mark offsets","status":"candidate"},
    {"id":"operando_xrd","family":"diffraction","x":"2theta (deg)","y":"time, cycle or SOC; intensity color","required":["radiation","time/SOC synchronization","color scale","cell configuration"],"never_infer":["phase evolution from generated heatmap"],"render":"heatmap with aligned electrochemical trace if available","status":"candidate"},
    {"id":"dsc","family":"thermal","x":"temperature (deg C)","y":"heat flow with stated sign","required":["heating rate","sample mass","atmosphere","exo/endo direction"],"never_infer":["onset from aesthetics"],"render":"measured trace and defined onset if calculated","status":"candidate"},
    {"id":"tga","family":"thermal","x":"temperature (deg C)","y":"remaining mass (%)","required":["heating rate","atmosphere","sample mass"],"never_infer":["composition from one loss step"],"render":"full measured trace","status":"candidate"},
    {"id":"arc","family":"thermal","x":"time or temperature","y":"temperature or dT/dt","required":["test protocol","SOC","trigger criterion","thermocouple location"],"never_infer":["T1/T2/T3 without definitions"],"render":"raw temperature and derived rate separately","status":"candidate"},
    {"id":"flammability","family":"safety","x":"time-sequence photographs","y":"not applicable","required":["original frames","ignition/removal timing","sample amount","SET definition if used"],"never_infer":["experimental flame from generated art"],"render":"same-scale original frames; visible timing","status":"candidate"},
    {"id":"pouch_cell","family":"practical_cell","x":"cycle number or time","y":"capacity/energy with boundary","required":["nominal capacity","loading","N/P","E/C","cell format","pressure","window","temperature"],"never_infer":["pack-level energy from active-mass capacity"],"render":"cycling with practical-condition table in caption","status":"candidate"},
    {"id":"pouch_surface_temperature","family":"thermal","x":"calibrated pouch width (mm)","y":"calibrated pouch height (mm); temperature (°C) encoded by color","required":["pouch outline and tab positions","IR calibration or sensor coordinates","ambient temperature","time and rate","fixed color scale across compared maps","processing log"],"never_infer":["measured hotspot from a simulated field","temperature outside calibrated range","tab position from image aesthetics"],"render":"temperature map with colorbar and true geometry; linked line profile or history only from same field","status":"candidate"},
    {"id":"ragone","family":"practical_cell","x":"specific power with basis","y":"specific energy with same basis","required":["mass/volume boundary","calculation method","measured or projected status"],"never_infer":["cross-boundary rankings"],"render":"points with source IDs and comparable boundaries","status":"candidate"},
    {"id":"literature_benchmark","family":"review","x":"declared comparable metric","y":"declared comparable metric","required":["source ID per point","cell configuration","metric denominator","conditions","screening rule"],"never_infer":["ranking unlike cells"],"render":"source-linked scatter/table with context","status":"candidate"},
    {"id":"condition_matrix","family":"review","x":"condition fields","y":"cited papers","required":["source ID per row","review protocol","reported","partially reported","NR","NV","NA"],"never_infer":["NR equals zero","NV equals NR"],"render":"categorical matrix; no fake source list in showcase","status":"candidate"}
  ],
