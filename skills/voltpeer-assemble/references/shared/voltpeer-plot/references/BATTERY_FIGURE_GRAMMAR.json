    {"id":"FULL_PROFILE_01","members":["full_cell_long_cycle","voltage_capacity_profile"],"status":"default_option","independent_primary_papers":["10.1002/adfm.202211364 Fig. 6b-e","10.1002/adfm.202209725 Fig. 4a-b","10.1002/smll.202311812 Fig. 4a-d"],"meaning":"Selected voltage profiles must belong to the corresponding measured cell/condition."}
